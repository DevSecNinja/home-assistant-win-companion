<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsCompanion_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsCompanion_App"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Companion for Home Assistant"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Companion for Home Assistant">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            NoLeftClickDelay="True"
            ToolTipText="Windows Companion for Home Assistant"
            IconSource="Assets/AppIcon.ico">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.OpenHomeAssistant" Text="Open Home Assistant" Click="OnOpenHomeAssistant" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Show" Text="Show Companion" Click="OnShowWindow" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Disconnect" Text="Disconnect" Click="OnDisconnect" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Exit" Text="Exit" Click="OnExit" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <!-- Connect view -->
        <StackPanel
            x:Name="ConnectPanel"
            Grid.Row="1"
            Width="380"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12">
            <TextBlock Text="Connect to Home Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Enter your Home Assistant URL. You'll sign in through your browser — no tokens to copy."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox
                x:Name="UrlBox"
                AutomationProperties.AutomationId="Connect.Url"
                Header="Home Assistant URL"
                PlaceholderText="http://homeassistant.local:8123"
                KeyDown="OnUrlBoxKeyDown" />
            <Button
                x:Name="SignInButton"
                AutomationProperties.AutomationId="Connect.SignIn"
                Content="Sign in"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSignIn" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock
                x:Name="ConnectError"
                AutomationProperties.AutomationId="Connect.Error"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>

        <!-- Status view -->
        <StackPanel
            x:Name="StatusPanel"
            Grid.Row="1"
            Width="380"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Text="Windows Companion for Home Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Server:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="ServerText" AutomationProperties.AutomationId="Status.Server" Text="—" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Address in use:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="RouteText" Text="—" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Status:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="Status.Connection" Text="Connecting…" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Health:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HealthText" AutomationProperties.AutomationId="Status.Health" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Battery:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryText" Text="—" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Last update:" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LastUpdateText" Text="—" />
            </StackPanel>
            <ToggleSwitch
                x:Name="StartWithWindowsToggle"
                Header="Start with Windows"
                OnContent="On"
                OffContent="Off"
                Toggled="OnStartWithWindowsToggled" />
            <TextBlock
                x:Name="StartupStatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button Content="Open Home Assistant" Click="OnOpenHomeAssistant" HorizontalAlignment="Stretch" />
            <Button Content="Connection…" Click="OnShowConnection" HorizontalAlignment="Stretch" />
            <Button x:Name="UpdateNowButton" AutomationProperties.AutomationId="Status.UpdateNow" Content="Update now" Click="OnForcePush" HorizontalAlignment="Stretch" />
            <Button AutomationProperties.AutomationId="Status.OpenSensors" Content="Sensors…" Click="OnShowSettings" HorizontalAlignment="Stretch" />
            <Button x:Name="DisconnectButton" AutomationProperties.AutomationId="Status.Disconnect" Content="Disconnect" Click="OnDisconnect" HorizontalAlignment="Stretch" />
            <Button Content="Open log file" Click="OnOpenLog" HorizontalAlignment="Stretch" />
            <Button
                AutomationProperties.AutomationId="Status.RemoveServer"
                Content="Remove server…"
                Click="OnRemoveServer"
                HorizontalAlignment="Stretch"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>

        <!-- Connection settings view -->
        <Grid x:Name="ConnectionPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="4">
                <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Use one Home Assistant address by default. If your internal and external addresses differ, enable separate URLs below."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,0">
                <StackPanel Spacing="12">
                    <TextBox
                        x:Name="SingleUrlBox"
                        Header="Home Assistant address"
                        PlaceholderText="https://homeassistant.example.com" />
                    <CheckBox
                        x:Name="UseSeparateUrlsBox"
                        Content="I use different internal and external URLs"
                        Checked="OnUseSeparateUrlsChanged"
                        Unchecked="OnUseSeparateUrlsChanged" />

                    <StackPanel x:Name="SeparateUrlsPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock
                            Text="Both addresses must reach the same Home Assistant instance. Keep the same sign-in, device, entities and history."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox
                            x:Name="InternalUrlBox"
                            Header="Internal address (on your own network)"
                            PlaceholderText="http://homeassistant.local:8123" />
                        <TextBox
                            x:Name="ExternalUrlBox"
                            Header="External address (from anywhere else, HTTPS only)"
                            PlaceholderText="https://example.duckdns.org" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Suggest from Home Assistant" Click="OnSuggestUrls" />
                            <TextBlock
                                x:Name="SuggestionText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox
                            x:Name="ConnectionModeBox"
                            Header="When to use which address"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Automatic" />
                            <ComboBoxItem Content="Prefer internal" />
                            <ComboBoxItem Content="Prefer external" />
                            <ComboBoxItem Content="Internal only" />
                            <ComboBoxItem Content="External only" />
                        </ComboBox>

                        <TextBlock Text="Trusted networks" FontWeight="SemiBold" />
                        <TextBlock
                            Text="The internal address is only used on networks you list here. These names stay on this PC: they are never sent to Home Assistant, never written to the log, and listing a network does not switch on the Wi-Fi sensors."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="CurrentNetworkText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="TrustNetworkButton" Content="Trust this network" Click="OnTrustCurrentNetwork" />
                        </StackPanel>
                        <StackPanel x:Name="TrustedNetworkList" Spacing="4" />
                        <CheckBox
                            x:Name="RequireBssidBox"
                            Content="Also match the exact access point (records its address; mesh Wi-Fi may fail)"
                            Checked="OnRequireBssidChanged"
                            Unchecked="OnRequireBssidChanged" />
                        <CheckBox x:Name="TrustWiredBox" Content="Treat any wired network as my own network" />
                        <CheckBox
                            x:Name="ProbeUnknownBox"
                            Content="Try the internal address as a fallback on unrecognised networks" />
                        <Button
                            Content="Open Windows Location settings"
                            Click="OnOpenLocationSettings"
                            HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="Windows only reveals the Wi-Fi network name to this app when Location is allowed. Without it, unrecognised networks use the external address."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <CheckBox
                        x:Name="AcknowledgeUnreachableBox"
                        Content="One address is deliberately unreachable from here; save it anyway"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ConnectionResultText"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="8">
                <ProgressRing x:Name="ConnectionProgress" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left" />
                <Button x:Name="TestRoutesButton" Content="Test URL" Click="OnTestRoutes" HorizontalAlignment="Stretch" />
                <Button
                    x:Name="SaveRoutesButton"
                    Content="Validate and save"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveRoutes"
                    HorizontalAlignment="Stretch" />
                <Button Content="Back" Click="OnCloseConnection" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Sensor settings view -->
        <Grid x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="4">
                <TextBlock Text="Sensors" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Choose what this PC reports to Home Assistant. Most enabled sensors send their latest value about once per minute. The Impact note explains extra checks, updates or internet use. Anything switched off is never collected or sent."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,0">
                <StackPanel x:Name="SensorList" AutomationProperties.AutomationId="Sensors.List" Spacing="4" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="12">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Idle after" VerticalAlignment="Center" />
                    <NumberBox
                        x:Name="IdleMinutesBox"
                        Minimum="1"
                        Maximum="240"
                        SpinButtonPlacementMode="Compact"
                        Width="120"
                        ValueChanged="OnIdleMinutesChanged" />
                    <TextBlock Text="minutes without input" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button
                    Content="Open Windows Location settings"
                    Click="OnOpenLocationSettings"
                    HorizontalAlignment="Stretch" />
                <Button AutomationProperties.AutomationId="Sensors.Save" Content="Back" Click="OnCloseSettings" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
