<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsCompanion_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsCompanion_App"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Companion for Home Assistant"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="4,0,0,0" />
            </Style>
            <Style x:Key="SettingsDescriptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style
                x:Key="SettingsActionButtonStyle"
                TargetType="Button"
                BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Companion for Home Assistant">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            NoLeftClickDelay="True"
            ToolTipText="Windows Companion for Home Assistant"
            IconSource="Assets/AppIcon.ico"
            DoubleClickCommand="{x:Bind TrayShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="TrayOpenHomeAssistantItem"
                        AutomationProperties.AutomationId="Tray.OpenHomeAssistant"
                        Text="Open Home Assistant"
                        Command="{x:Bind TrayOpenHomeAssistantCommand}" />
                    <MenuFlyoutItem
                        x:Name="TrayUpdateItem"
                        AutomationProperties.AutomationId="Tray.Update"
                        Text="Check for updates…"
                        Command="{x:Bind TrayUpdateCommand}" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Show" Text="Show Companion" Command="{x:Bind TrayShowWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="TrayDisconnectItem"
                        AutomationProperties.AutomationId="Tray.Disconnect"
                        Text="Disconnect"
                        Command="{x:Bind TrayDisconnectCommand}" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Exit" Text="Exit" Command="{x:Bind TrayExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <StackPanel Grid.Row="1">
            <InfoBar
                x:Name="DemoBanner"
                Margin="24,4,24,0"
                MaxWidth="680"
                HorizontalAlignment="Center"
                Severity="Warning"
                IsOpen="False"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Leave demo mode" Click="OnLeaveDemoMode" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Grid Margin="24,4,24,0" MaxWidth="680" HorizontalAlignment="Center">
                <InfoBar
                    x:Name="UpdateBanner"
                    HorizontalAlignment="Stretch"
                    Padding="0,8"
                    Severity="Informational"
                    IsOpen="False"
                    IsClosable="True">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="UpdateBannerTitleText"
                                Text="Update available"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="UpdateBannerMessage"
                                AutomationProperties.LiveSetting="Polite"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="ViewReleaseButton"
                                Content="View release"
                                Visibility="Collapsed"
                                Click="OnViewRelease" />
                            <Button
                                x:Name="RecheckUpdatesButton"
                                Content="Recheck for updates"
                                Visibility="Collapsed"
                                Click="OnRecheckUpdates" />
                        </StackPanel>
                    </Grid>
                </InfoBar>
            </Grid>
        </StackPanel>

        <!-- Connect view -->
        <StackPanel
            x:Name="ConnectPanel"
            Grid.Row="2"
            Width="380"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12">
            <TextBlock Text="Connect to Home Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Enter the HTTPS address you normally use to reach Home Assistant. You'll sign in through your browser — no tokens to copy."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox
                x:Name="UrlBox"
                AutomationProperties.AutomationId="Connect.Url"
                Header="Home Assistant URL"
                PlaceholderText="https://ha.example.com"
                KeyDown="OnUrlBoxKeyDown" />
            <Button
                x:Name="SignInButton"
                AutomationProperties.AutomationId="Connect.SignIn"
                Content="Sign in"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSignIn" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock
                x:Name="ConnectError"
                AutomationProperties.AutomationId="Connect.Error"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBlock
                Text="No server yet? Try demo mode to browse every sensor and its current value on this PC. Nothing is sent to Home Assistant."
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="DemoModeButton"
                Content="Explore in demo mode"
                IsEnabled="False"
                Click="OnEnterDemoMode"
                HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Status view -->
        <Grid x:Name="StatusPanel" Grid.Row="2" Visibility="Collapsed">
            <ScrollViewer Padding="24,12,24,24">
                <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="20">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Width="48"
                            Height="48"
                            Source="Assets/Square150x150Logo.scale-200.png"
                            AutomationProperties.Name="Windows Companion for Home Assistant logo" />
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Overview" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Text="Connection and device status at a glance."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid Padding="18,16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="StatusText"
                                    AutomationProperties.AutomationId="Status.Connection"
                                    Text="Connecting…"
                                    FontSize="18"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="ServerText"
                                    AutomationProperties.AutomationId="Status.Server"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="RouteText"
                                    Text="—"
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <Button
                                x:Name="OpenHomeAssistantButton"
                                Grid.Column="1"
                                Content="Open Home Assistant"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnOpenHomeAssistant" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="At a glance" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" RowSpacing="12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Connection health" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock
                                    x:Name="HealthText"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Status.Health"
                                    Text="—"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Battery" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock x:Name="BatteryText" Grid.Row="1" Grid.Column="1" Text="—" />
                                <TextBlock Grid.Row="2" Text="Last sensor sync" Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBlock x:Name="LastUpdateText" Grid.Row="2" Grid.Column="1" Text="—" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Manage" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Sensors" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Choose what this PC reports to Home Assistant."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Status.OpenSensors"
                                    Content="Manage sensors"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnShowSensors" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Application settings" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Configure startup, sync, updates and the connection."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Status.OpenSettings"
                                    AutomationProperties.Name="Open Settings"
                                    Content="Open settings"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnShowPreferences" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Application settings view -->
        <Grid x:Name="PreferencesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="24,12,24,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.AutomationId="Settings.Back"
                    AutomationProperties.Name="Back"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Click="OnClosePreferences">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Configure Windows Companion and its Home Assistant connection."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,12">
                <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="20">
                    <Border x:Name="ConnectionSettingsSection" Style="{StaticResource SettingsCardStyle}">
                        <Grid Padding="18,16" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="SettingsConnectionStatusText"
                                    Text="Connected"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    AutomationProperties.LiveSetting="Polite" />
                                <TextBlock
                                    x:Name="SettingsServerText"
                                    Text="Home Assistant"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="SettingsRouteText"
                                    Style="{StaticResource SettingsDescriptionStyle}"
                                    Text="Current route unavailable" />
                            </StackPanel>
                            <Button
                                x:Name="ConnectionButton"
                                Grid.Column="1"
                                Content="Connection settings"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnShowConnection" />
                        </Grid>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="General" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="StartupStatusText"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="StartWithWindowsToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="Start with Windows"
                                    OnContent=""
                                    OffContent=""
                                    Width="48"
                                    MinWidth="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Toggled="OnStartWithWindowsToggled" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Report inactive after" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Controls the Active sensor only; it does not lock or sleep this PC."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                    <NumberBox
                                        x:Name="IdleMinutesBox"
                                        Minimum="1"
                                        Maximum="240"
                                        SpinButtonPlacementMode="Compact"
                                        Width="104"
                                        AutomationProperties.Name="Inactive threshold in minutes"
                                        ValueChanged="OnIdleMinutesChanged" />
                                    <TextBlock Text="minutes" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Sensors" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Manage sensors" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="EnabledSensorCountText"
                                        Text="Sensor catalog unavailable"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="ChooseSensorsButton"
                                    Grid.Column="1"
                                    Content="Manage"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnShowSensorsFromSettings" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Sync sensor states" FontWeight="SemiBold" />
                                    <TextBlock
                                        x:Name="LastSensorSyncText"
                                        Text="Not synced yet"
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="SyncSensorsButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Settings.SyncSensors"
                                    Content="Sync now"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnForcePush" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="About &amp; support" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Updates" FontWeight="SemiBold" />
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            x:Name="SettingsUpdateProgress"
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,2,0"
                                            IsActive="False"
                                            Visibility="Collapsed"
                                            AutomationProperties.Name="Checking for updates" />
                                        <TextBlock Grid.Column="1" Text="Version" Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock Grid.Column="2" x:Name="InstalledVersionText" Text="—" Style="{StaticResource SettingsDescriptionStyle}" />
                                        <TextBlock
                                            Grid.Column="3"
                                            x:Name="SettingsUpdateStatusText"
                                            AutomationProperties.LiveSetting="Polite"
                                            Style="{StaticResource SettingsDescriptionStyle}" />
                                    </Grid>
                                    <TextBlock x:Name="LatestVersionText" Visibility="Collapsed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Button
                                        x:Name="SettingsCheckUpdatesButton"
                                        AutomationProperties.AutomationId="Settings.CheckUpdates"
                                        Content="Check for updates"
                                        Style="{StaticResource SettingsActionButtonStyle}"
                                        Click="OnRecheckUpdates" />
                                    <Button
                                        x:Name="SettingsInstallUpdateButton"
                                        Content="Install update…"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="OnViewRelease"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Logs" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Open the current diagnostic log for troubleshooting."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Content="Open logs"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnOpenLog" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ConnectionManagementSection" Spacing="8">
                        <TextBlock Text="Connection" Style="{StaticResource SettingsSectionHeaderStyle}" />
                        <Border Style="{StaticResource SettingsCardStyle}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Pause reporting" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Keeps the saved server and sign-in so you can reconnect later."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="DisconnectButton"
                                    Grid.Column="1"
                                    Content="Pause"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    AutomationProperties.AutomationId="Settings.Disconnect"
                                    VerticalAlignment="Center"
                                    Click="OnDisconnect" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Text="Danger zone"
                            Margin="4,12,0,0"
                            Style="{StaticResource SettingsSectionHeaderStyle}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <Border
                            Style="{StaticResource SettingsCardStyle}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}">
                            <Grid Padding="16,14" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="184" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock
                                        Text="Remove this server"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    <TextBlock
                                        Text="Signs out and deletes the saved server configuration from this PC."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <Button
                                    x:Name="RemoveServerButton"
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="Settings.RemoveServer"
                                    Content="Remove server…"
                                    Style="{StaticResource SettingsActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnRemoveServer"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
            <Grid
                Grid.Row="2"
                Margin="24,0,24,20"
                MaxWidth="680"
                HorizontalAlignment="Center">
                <InfoBar
                    x:Name="SettingsActionInfoBar"
                    HorizontalAlignment="Stretch"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Success">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing
                            x:Name="SettingsActionProgress"
                            IsActive="False"
                            Width="20"
                            Height="20"
                            AutomationProperties.Name="Settings action in progress" />
                        <TextBlock
                            x:Name="SettingsActionStatus"
                            AutomationProperties.AutomationId="Settings.ActionStatus"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </InfoBar>
            </Grid>
        </Grid>

        <!-- Connection settings view -->
        <Grid x:Name="ConnectionPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="24,12,24,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="Back"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Click="OnCloseConnection">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Choose how Windows Companion reaches your Home Assistant server."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,20">
                <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="16">
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Padding="18,16" Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Server addresses" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Use one address everywhere unless this server is reached differently on your local network."
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <TextBox
                                x:Name="SingleUrlBox"
                                Header="Home Assistant address"
                                PlaceholderText="https://homeassistant.example.com" />
                            <CheckBox
                                x:Name="UseSeparateUrlsBox"
                                Content="Use different internal and external addresses"
                                Checked="OnUseSeparateUrlsChanged"
                                Unchecked="OnUseSeparateUrlsChanged" />

                            <StackPanel x:Name="SeparateUrlsPanel" Spacing="14" Visibility="Collapsed">
                                <TextBlock
                                    Text="Both addresses must reach the same Home Assistant instance."
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                                <TextBox
                                    x:Name="InternalUrlBox"
                                    Header="Internal address"
                                    PlaceholderText="https://ha.lan.example" />
                                <TextBlock
                                    Text="Plain HTTP is allowed only for the internal address. Anyone on the matched local network could read or modify Home Assistant traffic."
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBox
                                    x:Name="ExternalUrlBox"
                                    Header="External address (HTTPS)"
                                    PlaceholderText="https://ha.example.com" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Suggest addresses" Click="OnSuggestUrls" />
                                    <TextBlock
                                        x:Name="SuggestionText"
                                        VerticalAlignment="Center"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox
                                    x:Name="ConnectionModeBox"
                                    Header="Routing behavior"
                                    HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Automatic — internal on a match, otherwise external" />
                                    <ComboBoxItem Content="Prefer internal — always try internal first" />
                                    <ComboBoxItem Content="Prefer external — always try external first" />
                                    <ComboBoxItem Content="Internal only — never try external" />
                                    <ComboBoxItem Content="External only — never try internal" />
                                </ComboBox>

                                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <StackPanel Spacing="3">
                                    <TextBlock Text="Trusted networks" FontWeight="SemiBold" />
                                    <TextBlock
                                        Text="Identify networks where the internal address is reachable. These details remain on this PC."
                                        Style="{StaticResource SettingsDescriptionStyle}" />
                                </StackPanel>
                                <TextBox
                                    x:Name="TrustedCidrsBox"
                                    Header="Network CIDRs (one per line)"
                                    PlaceholderText="192.168.50.0/24&#x0a;fd12:3456:789a::/48"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    MinHeight="88"
                                    TextChanged="OnTrustedCidrsChanged" />
                                <TextBlock
                                    x:Name="TrustedCidrsErrorText"
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    AutomationProperties.LiveSetting="Assertive"
                                    Visibility="Collapsed" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CurrentNetworkText" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button
                                        x:Name="TrustNetworkButton"
                                        Grid.Column="1"
                                        Content="Trust this network"
                                        Click="OnTrustCurrentNetwork" />
                                </Grid>
                                <StackPanel x:Name="TrustedNetworkList" Spacing="4" />
                                <CheckBox
                                    x:Name="RequireBssidBox"
                                    Content="Prefer the exact Wi-Fi access point when Windows can identify it; otherwise trust the Wi-Fi name"
                                    Checked="OnRequireBssidChanged"
                                    Unchecked="OnRequireBssidChanged" />
                                <CheckBox x:Name="TrustWiredBox" Content="Trust wired networks" />
                                <CheckBox
                                    x:Name="ProbeUnknownBox"
                                    Content="Try the internal address when Windows cannot identify the network" />
                                <Button
                                    Content="Open Windows Location settings"
                                    Click="OnOpenLocationSettings"
                                    HorizontalAlignment="Left" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <CheckBox
                        x:Name="AcknowledgeUnreachableBox"
                        Content="One address is deliberately unreachable from here; save it anyway"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ConnectionResultText"
                        Padding="4,0"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressRing
                            x:Name="ConnectionProgress"
                            Width="20"
                            Height="20"
                            IsActive="False"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="TestRoutesButton"
                            Grid.Column="1"
                            MinWidth="132"
                            Content="Test URL"
                            Click="OnTestRoutes" />
                        <Button
                            x:Name="SaveRoutesButton"
                            Grid.Column="2"
                            MinWidth="160"
                            Content="Validate and save"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnSaveRoutes" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Sensor settings view -->
        <Grid x:Name="SensorsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Padding="24,12,24,12" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.AutomationId="Sensors.Save"
                    AutomationProperties.Name="Back"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Click="OnCloseSensors">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Sensors" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="Choose what this PC reports. Disabled sensors are never collected or sent."
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,20">
                <StackPanel MaxWidth="680" HorizontalAlignment="Center" Spacing="12">
                    <StackPanel
                        x:Name="SensorList"
                        AutomationProperties.AutomationId="Sensors.List"
                        Spacing="8" />
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,8,0,0">
                        <Grid Padding="16,14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="184" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Windows location access" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="Required for Windows to reveal the current Wi-Fi network name."
                                    Style="{StaticResource SettingsDescriptionStyle}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Content="Windows settings"
                                Style="{StaticResource SettingsActionButtonStyle}"
                                VerticalAlignment="Center"
                                Click="OnOpenLocationSettings" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
