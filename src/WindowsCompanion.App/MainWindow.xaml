<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WindowsCompanion_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WindowsCompanion_App"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Windows Companion for Home Assistant"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="Windows Companion for Home Assistant">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            NoLeftClickDelay="True"
            ToolTipText="Windows Companion for Home Assistant"
            IconSource="Assets/AppIcon.ico"
            DoubleClickCommand="{x:Bind TrayShowWindowCommand}">
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="TrayOpenHomeAssistantItem"
                        AutomationProperties.AutomationId="Tray.OpenHomeAssistant"
                        Text="Open Home Assistant"
                        Command="{x:Bind TrayOpenHomeAssistantCommand}" />
                    <MenuFlyoutItem
                        x:Name="TrayUpdateItem"
                        AutomationProperties.AutomationId="Tray.Update"
                        Text="Check for updates…"
                        Command="{x:Bind TrayUpdateCommand}" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Show" Text="Show Companion" Command="{x:Bind TrayShowWindowCommand}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="TrayDisconnectItem"
                        AutomationProperties.AutomationId="Tray.Disconnect"
                        Text="Disconnect"
                        Command="{x:Bind TrayDisconnectCommand}" />
                    <MenuFlyoutItem AutomationProperties.AutomationId="Tray.Exit" Text="Exit" Command="{x:Bind TrayExitCommand}" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>

        <StackPanel Grid.Row="1">
            <InfoBar
                x:Name="DemoBanner"
                Margin="24,4,24,0"
                Severity="Warning"
                IsOpen="False"
                IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Leave demo mode" Click="OnLeaveDemoMode" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                x:Name="UpdateBanner"
                Margin="24,4,24,0"
                Title="Update available"
                Severity="Informational"
                IsOpen="False"
                IsClosable="False">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="UpdateBannerMessage"
                        AutomationProperties.LiveSetting="Polite"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ViewReleaseButton"
                            Content="View release"
                            Visibility="Collapsed"
                            Click="OnViewRelease" />
                        <Button
                            x:Name="RecheckUpdatesButton"
                            Content="Recheck for updates"
                            Visibility="Collapsed"
                            Click="OnRecheckUpdates" />
                    </StackPanel>
                </StackPanel>
            </InfoBar>
        </StackPanel>

        <!-- Connect view -->
        <StackPanel
            x:Name="ConnectPanel"
            Grid.Row="2"
            Width="380"
            Padding="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Spacing="12">
            <TextBlock Text="Connect to Home Assistant" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Enter the HTTPS address you normally use to reach Home Assistant. You'll sign in through your browser — no tokens to copy."
                TextWrapping="Wrap"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox
                x:Name="UrlBox"
                AutomationProperties.AutomationId="Connect.Url"
                Header="Home Assistant URL"
                PlaceholderText="https://ha.example.com"
                KeyDown="OnUrlBoxKeyDown" />
            <Button
                x:Name="SignInButton"
                AutomationProperties.AutomationId="Connect.SignIn"
                Content="Sign in"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSignIn" />
            <ProgressRing x:Name="SignInProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock
                x:Name="ConnectError"
                AutomationProperties.AutomationId="Connect.Error"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
            <TextBlock
                Text="No server yet? Try demo mode to browse every sensor and its current value on this PC. Nothing is sent to Home Assistant."
                TextWrapping="Wrap"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="DemoModeButton"
                Content="Explore in demo mode"
                IsEnabled="False"
                Click="OnEnterDemoMode"
                HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Status view -->
        <StackPanel
            x:Name="StatusPanel"
            Grid.Row="2"
            MaxWidth="460"
            Margin="24,20,24,24"
            VerticalAlignment="Top"
            HorizontalAlignment="Stretch"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock Text="Connection status" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Server" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="ServerText"
                    Grid.Row="0"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Status.Server"
                    Text="—"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1" Text="Address in use" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="RouteText"
                    Grid.Row="1"
                    Grid.Column="1"
                    Text="—"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Text="Status" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="StatusText"
                    Grid.Row="2"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Status.Connection"
                    Text="Connecting…"
                    FontWeight="SemiBold" />

                <TextBlock Grid.Row="3" Text="Health" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    x:Name="HealthText"
                    Grid.Row="3"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Status.Health"
                    Text="—"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Text="Battery" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryText" Grid.Row="4" Grid.Column="1" Text="—" />

                <TextBlock Grid.Row="5" Text="Last update" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="LastUpdateText" Grid.Row="5" Grid.Column="1" Text="—" />
            </Grid>
            <Button
                x:Name="OpenHomeAssistantButton"
                Content="Open Home Assistant"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnOpenHomeAssistant"
                HorizontalAlignment="Stretch" />
            <Button AutomationProperties.AutomationId="Status.OpenSensors"
                    Content="Sensors" Click="OnShowSensors" HorizontalAlignment="Stretch" />
            <Button AutomationProperties.AutomationId="Status.OpenSettings"
                    AutomationProperties.Name="Open Settings"
                    Content="Settings" Click="OnShowPreferences" HorizontalAlignment="Stretch" />
        </StackPanel>

        <!-- Application settings view -->
        <Grid x:Name="PreferencesPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Configure how the companion behaves and manage its connection to Home Assistant."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,0">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="General" FontWeight="SemiBold" />
                        <ToggleSwitch
                            x:Name="StartWithWindowsToggle"
                            Header="Start with Windows"
                            OnContent="On"
                            OffContent="Off"
                            Toggled="OnStartWithWindowsToggled" />
                        <TextBlock
                            x:Name="StartupStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <TextBlock Text="Idle after" VerticalAlignment="Center" />
                            <NumberBox
                                x:Name="IdleMinutesBox"
                                Minimum="1"
                                Maximum="240"
                                SpinButtonPlacementMode="Compact"
                                Width="120"
                                AutomationProperties.Name="Idle threshold in minutes"
                                ValueChanged="OnIdleMinutesChanged" />
                            <TextBlock Text="minutes without input" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="This only controls when the Active sensor reports idle. It does not lock or put this PC to sleep."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Sensors" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Send the latest states for every enabled sensor to Home Assistant immediately."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="SyncSensorsButton"
                            AutomationProperties.AutomationId="Settings.SyncSensors"
                            Content="Sync sensors now"
                            Click="OnForcePush"
                            HorizontalAlignment="Stretch" />
                        <Button x:Name="ChooseSensorsButton" Content="Choose sensors"
                                Click="OnShowSensorsFromSettings" HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel x:Name="ConnectionSettingsSection" Spacing="10">
                        <TextBlock Text="Connection" FontWeight="SemiBold" />
                        <Button x:Name="ConnectionButton" Content="Connection settings"
                                Click="OnShowConnection" HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="Stopping the connection pauses reporting until you reconnect. It keeps your server and sign-in information."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="DisconnectButton" Content="Stop connection"
                                AutomationProperties.AutomationId="Settings.Disconnect"
                                Click="OnDisconnect" HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="Removing the server signs out, deletes its saved configuration from this PC, and requires a new sign-in."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="RemoveServerButton"
                            AutomationProperties.AutomationId="Settings.RemoveServer"
                            Content="Remove server…"
                            Click="OnRemoveServer"
                            HorizontalAlignment="Stretch"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="10">
                        <TextBlock Text="About &amp; updates" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Installed version:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="InstalledVersionText" Text="—" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Latest stable version:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="LatestVersionText" Text="Not checked" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SettingsUpdateStatusText"
                            TextWrapping="Wrap"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button
                            x:Name="SettingsCheckUpdatesButton"
                            Content="Check for updates"
                            Click="OnRecheckUpdates"
                            HorizontalAlignment="Stretch" />
                        <Button
                            x:Name="SettingsInstallUpdateButton"
                            Content="Install update…"
                            Click="OnViewRelease"
                            Visibility="Collapsed"
                            HorizontalAlignment="Stretch" />
                        <Button Content="Open log file" Click="OnOpenLog" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="8">
                <ProgressRing x:Name="SettingsActionProgress" IsActive="False"
                              Width="20" Height="20" HorizontalAlignment="Left"
                              AutomationProperties.Name="Settings action in progress" />
                <TextBlock
                    x:Name="SettingsActionStatus"
                    AutomationProperties.AutomationId="Settings.ActionStatus"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite"
                    Visibility="Collapsed" />
                <Button AutomationProperties.AutomationId="Settings.Back"
                        Content="Back" Click="OnClosePreferences" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Connection settings view -->
        <Grid x:Name="ConnectionPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="4">
                <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Use one address everywhere by default. Configure separate addresses only when Home Assistant is reached differently on your local networks and everywhere else."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,0">
                <StackPanel Spacing="12">
                    <TextBox
                        x:Name="SingleUrlBox"
                        Header="Home Assistant address"
                        PlaceholderText="https://homeassistant.example.com" />
                    <CheckBox
                        x:Name="UseSeparateUrlsBox"
                        Content="I use different internal and external URLs"
                        Checked="OnUseSeparateUrlsChanged"
                        Unchecked="OnUseSeparateUrlsChanged" />

                    <StackPanel x:Name="SeparateUrlsPanel" Spacing="12" Visibility="Collapsed">
                        <TextBlock
                            Text="Both addresses must reach the same Home Assistant instance. “Internal” means reachable on networks you configure below; “external” means the address to try everywhere else."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox
                            x:Name="InternalUrlBox"
                            Header="Internal address (reachable on configured local networks)"
                            PlaceholderText="https://ha.lan.example" />
                        <TextBox
                            x:Name="ExternalUrlBox"
                            Header="External address (reachable everywhere else, HTTPS only)"
                            PlaceholderText="https://ha.example.com" />
                        <TextBlock
                            Text="Use HTTPS for both addresses. Plain HTTP is allowed only for the internal address when you deliberately accept that anyone on the matched local network could read or alter the traffic."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Suggest from Home Assistant" Click="OnSuggestUrls" />
                            <TextBlock
                                x:Name="SuggestionText"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox
                            x:Name="ConnectionModeBox"
                            Header="Routing behavior"
                            HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Automatic — internal on a match, otherwise external" />
                            <ComboBoxItem Content="Prefer internal — always try internal first" />
                            <ComboBoxItem Content="Prefer external — always try external first" />
                            <ComboBoxItem Content="Internal only — never try external" />
                            <ComboBoxItem Content="External only — never try internal" />
                        </ComboBox>
                        <TextBlock
                            Text="A fallback is tried only when the first address cannot connect. In Automatic mode, a matched network tries internal then external; a definite nonmatch uses external only."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Trusted networks" FontWeight="SemiBold" />
                        <TextBlock
                            Text="Add IPv4 or IPv6 CIDR blocks for networks where the internal address is reachable. If any active Ethernet or Wi-Fi address falls inside a block, Automatic mode may use the internal address. CIDRs and Wi-Fi identifiers stay on this PC and are never written to the log or sent to Home Assistant."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox
                            x:Name="TrustedCidrsBox"
                            Header="Network CIDRs (one per line)"
                            PlaceholderText="192.168.50.0/24&#x0a;fd12:3456:789a::/48"
                            AcceptsReturn="True"
                            TextWrapping="NoWrap"
                            MinHeight="88"
                            TextChanged="OnTrustedCidrsChanged" />
                        <TextBlock
                            x:Name="TrustedCidrsErrorText"
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            AutomationProperties.LiveSetting="Assertive"
                            Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="CurrentNetworkText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="TrustNetworkButton" Content="Trust this network" Click="OnTrustCurrentNetwork" />
                        </StackPanel>
                        <StackPanel x:Name="TrustedNetworkList" Spacing="4" />
                        <CheckBox
                            x:Name="RequireBssidBox"
                            Content="Also match the exact access point (records its address; mesh Wi-Fi may fail)"
                            Checked="OnRequireBssidChanged"
                            Unchecked="OnRequireBssidChanged" />
                        <CheckBox x:Name="TrustWiredBox" Content="Treat any wired network as my own network" />
                        <CheckBox
                            x:Name="ProbeUnknownBox"
                            Content="If the network cannot be identified, try external first and internal as a fallback" />
                        <Button
                            Content="Open Windows Location settings"
                            Click="OnOpenLocationSettings"
                            HorizontalAlignment="Stretch" />
                        <TextBlock
                            Text="Windows only reveals the Wi-Fi name when Location is allowed. CIDR matching can still identify a network from active interface addresses; otherwise Automatic mode uses the external address."
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <CheckBox
                        x:Name="AcknowledgeUnreachableBox"
                        Content="One address is deliberately unreachable from here; save it anyway"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="ConnectionResultText"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="8">
                <ProgressRing x:Name="ConnectionProgress" IsActive="False" Width="20" Height="20" HorizontalAlignment="Left" />
                <Button x:Name="TestRoutesButton" Content="Test URL" Click="OnTestRoutes" HorizontalAlignment="Stretch" />
                <Button
                    x:Name="SaveRoutesButton"
                    Content="Validate and save"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="OnSaveRoutes"
                    HorizontalAlignment="Stretch" />
                <Button Content="Back" Click="OnCloseConnection" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Sensor settings view -->
        <Grid x:Name="SensorsPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="24,16,24,8" Spacing="4">
                <TextBlock Text="Sensors" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Text="Choose what this PC reports to Home Assistant. Most enabled sensors send their latest value about once per minute. The Impact note explains extra checks, updates or internet use. Anything switched off is never collected or sent."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Padding="24,0,24,0">
                <StackPanel x:Name="SensorList" AutomationProperties.AutomationId="Sensors.List" Spacing="4" />
            </ScrollViewer>

            <StackPanel Grid.Row="2" Padding="24,8,24,20" Spacing="12">
                <Button
                    Content="Open Windows Location settings"
                    Click="OnOpenLocationSettings"
                    HorizontalAlignment="Stretch" />
                <Button AutomationProperties.AutomationId="Sensors.Save"
                        Content="Back" Click="OnCloseSensors" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
